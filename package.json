    "a-signal": "^2.3.0",
    "electron-updater": "^6.3.9",
    "fastify": "^5.8.4",
    "gray-matter": "^4.0.3",
    "ws": "^8.20.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.2",
    "electron": "^39.2.6",
    "electron-builder": "^26.0.12",
    "electron-vite": "^5.0.0",
    "esbuild": "^0.27.4",
